---
import Logo from '../components/Logo.astro';

const navItems = [
    { num: '01', linkText: 'Quen somos', href: '#quen-somos' },
    { num: '02', linkText: 'Misión e visión', href: '#mision-vision' },
    { num: '03', linkText: 'Valores', href: '#valores' },
    { num: '04', linkText: 'Liñas de traballo', href: '#lineas-traballo' },
    { num: '05', linkText: 'Calendario', href: '#eventos' },
    { num: '06', linkText: 'Contacto', href: '#contacto' }
];

const membershipFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSeo0hy-RgPpW85MApm6Zzgtgq8kTk82u757hnAWgMHbCZJCZA/viewform';
---

<header class="reveal w-full bg-paper hairline-b" data-step="1">
    <nav class="flex flex-wrap items-center justify-between gap-4 py-5 container-xl">
        <a href="/" class="shrink-0 no-underline">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-flex items-center gap-1.5 text-sm font-semibold tracking-wide text-dark no-underline uppercase hover:text-accent">
                                <span class="font-mono text-xs text-accent">{item.num}</span>
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
        <a href={membershipFormUrl} target="_blank" rel="noopener noreferrer" class="btn btn-navy shrink-0">
            <span class="inline-block w-1.5 h-1.5 bg-accent"></span>
            Faite socio/a
        </a>
    </nav>
</header>
