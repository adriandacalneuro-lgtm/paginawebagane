---
interface Props {
    class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flex items-center gap-4 ${className}`}>
    <img src="/favicon.png" alt="" class="object-cover w-16 h-16 border border-ink sm:w-20 sm:h-20" />
    <span class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">AGANE</span>
</div>
